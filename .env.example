# Local development only. Demo payment endpoints are disabled in production.
APP_URL=http://localhost:3000
DEMO_MODE=true
# Replace with random values before deploying (openssl rand -hex 32).
APP_SECRET=
ADMIN_TOKEN=
CRON_SECRET=
# Production requires PostgreSQL and private S3-compatible storage.
DATABASE_URL=
AWS_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for a SINGLE SERVER with persistent disks; never use on serverless.
ALLOW_LOCAL_STORAGE=
# Razorpay test keys first; activate/KYC before switching to live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Resend is required for live checkout; verify your sending domain first.
RESEND_API_KEY=
MAIL_FROM=
# Real operator information shown on the policies page.
BUSINESS_NAME=
BUSINESS_ADDRESS=
SUPPORT_EMAIL=
